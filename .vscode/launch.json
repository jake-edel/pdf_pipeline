{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Text to JSON",
      "program": "${workspaceFolder}/src/textToJson.ts",
			"args": ["${workspaceFolder}/text/2025-06.txt"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [ "<node_internals>/**", "**/node_modules/**" ]
    },
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Run Scratchpad",
      "program": "${workspaceFolder}/src/scratchpad.ts",
			"args": ["${workspaceFolder}/text/2025-06.txt"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [ "<node_internals>/**", "**/node_modules/**" ]
    }
  ]
}
